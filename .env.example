# Найпростіше заповнити цей файл командою «npm run setup».

# Postgres. Supabase: Connect → Session pooler → рядок підключення з паролем бази.
DATABASE_URL=postgresql://postgres.<ref>:<пароль>@aws-0-<регіон>.pooler.supabase.com:5432/postgres
# Секрет для шифрування API-ключів у БД (не коротший за 16 символів). Не змінюйте після запуску.
MASTER_KEY=
# Пароль входу в дашборд
DASHBOARD_PASSWORD=
# Необов’язково: повний шлях до scrapling, якщо його немає в PATH
# SCRAPLING_BIN=
