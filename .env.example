# Postgres. Supabase: Connect → Session pooler → рядок підключення.
# Локально: docker compose up -d db і рядок нижче.
DATABASE_URL=postgres://parsing:parsing@localhost:5433/parsing
# Секрет для шифрування API-ключів у БД. Згенерувати: openssl rand -base64 32
MASTER_KEY=
# Пароль входу в дашборд
DASHBOARD_PASSWORD=
# Необов’язково: повний шлях до scrapling, якщо його немає в PATH
# SCRAPLING_BIN=
