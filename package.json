{
  "name": "parsing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "keys:import": "tsx --env-file-if-exists=.env src/keys/import.ts",
    "launch": "node scripts/launch.mjs",
    "shortcut": "node scripts/shortcut.mjs",
    "doctor": "node scripts/doctor.mjs",
    "setup": "tsx scripts/setup.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "ffmpeg-static": "^5.3.0",
